{
  "manifest_version": 3,
  "name": "Extension Discord Web Auto Quest",
  "version": "1.3.0",
  "minimum_chrome_version": "111",
  "description": "Réalisez automatiquement les quêtes Discord dans votre navigateur, sans aucune intervention manuelle",
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://canary.discord.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://canary.discord.com/*"],
      "js": ["quest-home.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://discord.com/*", "https://canary.discord.com/*"],
      "js": ["user-agent-override.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/frflag.png", "assets/gbflag.png", "assets/esflag.png", "assets/quest-icon.svg", "assets/expand-arrow.svg"],
      "matches": ["https://discord.com/*", "https://canary.discord.com/*"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
